# =====================================================
# LEGALRAG - CONFIGURACIÓN DE ENTORNO
# =====================================================

# Servidor
APP_NAME=LegalRAG
APP_ENV=development
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
API_PREFIX=/api/v1

# Base de datos PostgreSQL
DATABASE_URL=postgresql+asyncpg://legalrag:legalrag_secret@localhost:5432/legalrag_db

# Qdrant (Vector Database)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=jurisprudencia

# OpenAI (para LLM - opcional, puede usar modelos locales)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4-turbo-preview

# Embeddings (modelo local gratuito)
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# JWT
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Almacenamiento
UPLOAD_DIR=/app/data/uploads
EXPORT_DIR=/app/data/exports
MAX_UPLOAD_SIZE_MB=50

# CORS (frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
