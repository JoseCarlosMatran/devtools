# Configuración para desarrollo con Docker (PostgreSQL + Qdrant)

# Aplicación
APP_NAME=LegalRAG
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Base de datos PostgreSQL
DATABASE_URL=postgresql+asyncpg://legalrag:legalrag_secret@localhost:5432/legalrag

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=jurisprudencia

# OpenAI (añade tu API key aquí)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024

# JWT
JWT_SECRET_KEY=jwt-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Almacenamiento
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
MAX_UPLOAD_SIZE_MB=50

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
